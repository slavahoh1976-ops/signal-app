{
  "name": "signal-desktop",
  "productName": "Сигнал",
  "version": "1.0.0",
  "description": "Сигнал — схемы видеосигнала",
  "author": "Khokhryakov Viatcheslav",
  "main": "main.js",
  "private": true,
  "scripts": { "dist": "electron-builder" },
  "devDependencies": {
    "electron": "26.6.10",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "ru.slavahoh.signal",
    "productName": "Сигнал",
    "copyright": "© 2026 Khokhryakov Viatcheslav",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json", "web/**"],
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": ["dir"],
      "identity": null,
      "minimumSystemVersion": "10.14.0",
      "artifactName": "Signal-Mac-${arch}.${ext}"
    },
    "win": { "target": ["nsis", "portable"], "artifactName": "Signal-Windows-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Сигнал", "artifactName": "Signal-Windows-Setup.${ext}" },
    "portable": { "artifactName": "Signal-Windows-Portable.${ext}" }
  }
}
